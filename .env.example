# ==========================================
# Option 1: Google Cloud Project (Vertex AI) - Recommended for Hackathon
# ==========================================
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east5
# Optional if using Service Account JSON file directly:
# GOOGLE_APPLICATION_CREDENTIALS=config/gcp-service-account.json

# ==========================================
# Option 2: Google AI Studio API Key
# ==========================================
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# Partner Service: ClickHouse Cloud (Telemetry & MCP Memory)
# ==========================================
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password

# ==========================================
# Model & Split-Conformal Settings
# ==========================================
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
CONFIDENCE_LEVEL_ALPHA=0.10
HIGH_UNCERTAINTY_THRESHOLD=20.0
